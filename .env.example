# ---- Database ----
DB_NAME=neelastack
DB_USERNAME=neelastack
DB_PASSWORD=change-me-strong-password

# ---- Deployment (docker-compose.prod.yml image resolution) ----
# Must match the (lowercased) GitHub repository owner used by .github/workflows/ci-cd.yml
# when it builds/pushes to ghcr.io -- e.g. for github.com/your-org/neelastack this is
# "your-org". Wrong or missing value here means `docker compose pull` on the VM resolves
# a different image path than CI actually pushed to. GHCR image paths are always
# lowercase -- if your GitHub org/username has uppercase letters, lowercase it here too.
GITHUB_REPOSITORY_OWNER=your-org
# Set automatically by infra/deploy/deploy.sh at deploy time (defaults to `latest` if unset) --
# you normally don't need to set this by hand in .env.
IMAGE_TAG=latest

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-password

# ---- Backend / JWT ----
JWT_SECRET=change-this-to-a-long-random-256-bit-secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
# Only list origins that actually resolve. Your Cloudflare Tunnel currently has an
# ingress rule for neelastack.com only (no www.neelastack.com) -- listing an origin
# here that isn't actually reachable doesn't break anything, but a mismatch in the
# other direction (a real origin missing from this list) will make the browser's CORS
# preflight fail for every API call from that origin. Add www. here (comma-separated,
# no spaces) once/if you add a matching www.neelastack.com rule in the tunnel.
CORS_ALLOWED_ORIGINS=https://neelastack.com

# ---- Initial admin bootstrap (first boot only -- see AdminBootstrapRunner) ----
# Used exactly once, only if no admin account exists yet. The bootstrapped account is
# forced to change this password (and enroll MFA) before it can do anything else --
# treat this password as a one-time, throwaway secret, not the admin's real password.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---- Mail (SMTP) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@neelastack.com
MAIL_ADMIN_ADDRESS=admin@neelastack.com

# ---- Site ----
SITE_BASE_URL=https://neelastack.com

# ---- Cloudinary (added in Phase 4) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required in production (CloudinaryConfig fails startup if blank) -- signs time-limited
# authenticated delivery URLs for private/client-only files. Generate a long random value.
CLOUDINARY_AUTH_TOKEN_KEY=

# ---- MFA (TOTP) ----
# Required in production (StartupSecretsValidator fails startup on the insecure all-zero
# dev default). Must be a 32-byte key, base64-encoded, used for AES-256-GCM encryption of
# stored TOTP secrets. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Neelastack
MFA_STEP_UP_TTL_MINUTES=10

# ---- Razorpay (added in Phase 5) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# How long a CREATED payment_attempt is treated as still-valid before InvoiceService#createOrder
# mints a fresh Razorpay order instead of handing back a possibly-expired one. Optional --
# defaults to 60 if unset.
RAZORPAY_ORDER_TTL_MINUTES=60
# How often PaymentReconciliationService polls Razorpay for stale PENDING invoices, in ms.
RAZORPAY_RECONCILE_INTERVAL_MS=1200000

# ---- Observability (Phase 6) ----
SENTRY_DSN=

# ---- Google OAuth2 (added later) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=https://neelastack.com
