# Environment files — never commit real secrets. .env.example is the only tracked template.
.env
.env.*
!.env.example

# Node / Angular
node_modules/
dist/
.angular/
npm-debug.log*
yarn-error.log*

# Java / Maven
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Test / coverage / E2E artifacts
coverage/
playwright-report/
test-results/
e2e/node_modules/
e2e/playwright-report/
e2e/test-results/
# Cached admin TOTP secret for local re-runs against a persisted Postgres volume
# (see e2e/global-setup.ts) -- never commit a real account's MFA secret.
e2e/.e2e-admin-mfa-secret.json
e2e/.e2e-razorpay-fixture.json
e2e/.e2e-admin-storage-state.json

# Logs
*.log
logs/

# OS / editor
.idea/
.vscode/
.DS_Store
Thumbs.db

# Build/deploy scratch
*.tmp
*.bak
deploy_key
known_hosts

.env
